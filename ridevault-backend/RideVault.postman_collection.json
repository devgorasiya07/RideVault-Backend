{
  "info": {
    "name": "RideVault REST API (Spring Boot 4 + JWT)",
    "_postman_id": "ridevault-api-collection-2026",
    "description": "Complete REST API collection for RideVault with JWT authentication, optimistic locking ride claims, and transactional wallet settlements.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Rider",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Dev\",\n  \"lastName\": \"Gorasiya\",\n  \"email\": \"dev@ridevault.com\",\n  \"phoneNo\": \"9876543210\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register/rider",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register", "rider"]
            }
          }
        },
        {
          "name": "Register Driver",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Raj\",\n  \"lastName\": \"Patel\",\n  \"email\": \"raj.driver@ridevault.com\",\n  \"phoneNo\": \"9876543211\",\n  \"password\": \"password123\",\n  \"licenseNo\": \"GJ0120220019283\",\n  \"vehicleCategory\": \"SEDAN\",\n  \"vehicleModel\": \"Maruti Suzuki Dzire\",\n  \"vehicleYear\": 2022,\n  \"plateNo\": \"GJ-01-AB-1234\",\n  \"insurancePolicyNo\": \"POL-9988221\",\n  \"insuranceExpiryDate\": \"2027-12-31\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register/driver",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register", "driver"]
            }
          }
        },
        {
          "name": "Login (Captures JWT Automatically)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.accessToken) {",
                  "    pm.environment.set(\"jwt_token\", jsonData.data.accessToken);",
                  "    console.log(\"Captured JWT token: \" + jsonData.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dev@ridevault.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Rides",
      "item": [
        {
          "name": "Estimate Fares (All Categories)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/rides/estimate-fares?pickupAddress=Infocity%20IT%20Park&pickupLat=23.1885&pickupLng=72.6285&dropoffAddress=GIFT%20City&dropoffLat=23.1610&dropoffLng=72.6823",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "rides", "estimate-fares"],
              "query": [
                {"key": "pickupAddress", "value": "Infocity IT Park"},
                {"key": "pickupLat", "value": "23.1885"},
                {"key": "pickupLng", "value": "72.6285"},
                {"key": "dropoffAddress", "value": "GIFT City"},
                {"key": "dropoffLat", "value": "23.1610"},
                {"key": "dropoffLng", "value": "72.6823"}
              ]
            }
          }
        },
        {
          "name": "Book Ride",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickupAddress\": \"Infocity IT Park\",\n  \"pickupLat\": 23.1885,\n  \"pickupLng\": 72.6285,\n  \"dropoffAddress\": \"GIFT City\",\n  \"dropoffLat\": 23.1610,\n  \"dropoffLng\": 72.6823,\n  \"vehicleCategory\": \"SEDAN\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/rides/book",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "rides", "book"]
            }
          }
        },
        {
          "name": "View Pending Rides (Driver Category)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/rides/available",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "rides", "available"]
            }
          }
        },
        {
          "name": "Accept Ride (Optimistic Locking)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/rides/1/accept",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "rides", "1", "accept"]
            }
          }
        },
        {
          "name": "Mark Driver Arrived (ARRIVED)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/rides/1/status?targetStatus=ARRIVED&reason=Driver%20arrived%20at%20pickup",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "rides", "1", "status"],
              "query": [
                {"key": "targetStatus", "value": "ARRIVED"},
                {"key": "reason", "value": "Driver arrived at pickup"}
              ]
            }
          }
        },
        {
          "name": "Start Ride (IN_PROGRESS + 4-Digit Start PIN)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/rides/1/status?targetStatus=IN_PROGRESS&startPin=1234&reason=Rider%20boarded",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "rides", "1", "status"],
              "query": [
                {"key": "targetStatus", "value": "IN_PROGRESS"},
                {"key": "startPin", "value": "1234"},
                {"key": "reason", "value": "Rider boarded"}
              ]
            }
          }
        },
        {
          "name": "Complete Ride & Settle Wallet Payout",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/rides/1/complete?collectedFare=210.00",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "rides", "1", "complete"],
              "query": [
                {"key": "collectedFare", "value": "210.00"}
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Wallet",
      "item": [
        {
          "name": "Get Wallet Balance & Transactions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/wallet/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "wallet", "me"]
            }
          }
        },
        {
          "name": "Withdraw Funds",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500.00\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/wallet/withdraw",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "wallet", "withdraw"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "jwt_token",
      "value": ""
    }
  ]
}
